---
import "../styles/global.css";
import { APP_NAME } from "@/config/app";

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `${APP_NAME} - Sistema de Fidelización`,
  description = "Sistema de fidelización para comercios y clientes. Acumula puntos y obtén recompensas."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-background min-h-screen">
    <slot />
  </body>
</html>
