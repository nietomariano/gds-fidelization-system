---
import CustomerLayout from "../../layouts/Customer/CustomerLayout.astro";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { AlertCircle, ShoppingBag, Gift } from "lucide-react";
import { Badge } from "@/components/ui/badge";

// TODO: Obtener estos datos del backend
const purchases: any[] = [];
const redeems: any[] = [];
const businesses: any[] = [];

const allActivity = [
  ...purchases.map((p: any) => ({ ...p, type: "purchase" })),
  ...redeems.map((r: any) => ({ ...r, type: "redeem" })),
].sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
---

<CustomerLayout title="Historial">
  <div class="space-y-6">
    <div>
      <h2 class="text-3xl font-bold tracking-tight">Historial</h2>
      <p class="text-muted-foreground">Todas tus compras y canjes en un solo lugar</p>
    </div>

    <Card>
      <CardHeader>
        <CardTitle>Actividad Completa</CardTitle>
        <CardDescription>Todas tus transacciones ordenadas por fecha</CardDescription>
      </CardHeader>
      <CardContent>
        {allActivity.length === 0 ? (
          <div class="flex flex-col items-center justify-center py-12 text-center">
            <AlertCircle className="mb-4 size-16 text-muted-foreground" />
            <p class="text-muted-foreground">No hay actividad registrada</p>
          </div>
        ) : (
          <div class="space-y-3">
            {allActivity.map((item: any) => {
              const business = businesses.find((b: any) => b.id === item.business_id);
              const isPurchase = item.type === "purchase";
              
              return (
                <div class="flex items-start justify-between rounded-lg border p-4">
                  <div class="flex items-start gap-3">
                    <div class={`flex size-10 items-center justify-center rounded-full ${
                      isPurchase ? "bg-green-100 text-green-600" : "bg-blue-100 text-blue-600"
                    }`}>
                      {isPurchase ? <ShoppingBag className="size-5" /> : <Gift className="size-5" />}
                    </div>
                    <div>
                      <p class="font-medium">{business?.name || "Comercio"}</p>
                      {isPurchase ? (
                        <p class="text-sm text-muted-foreground">
                          Compra: ${item.amount.toFixed(2)} • +{item.points} pts
                        </p>
                      ) : (
                        <p class="text-sm text-muted-foreground">
                          Canje: {item.rewardName} • -{item.pointsUsed} pts
                        </p>
                      )}
                      <p class="text-xs text-muted-foreground">
                        {new Date(item.createdAt).toLocaleString()}
                      </p>
                    </div>
                  </div>
                  <Badge variant={isPurchase ? "default" : "secondary"}>
                    {isPurchase ? "Compra" : "Canje"}
                  </Badge>
                </div>
              );
            })}
          </div>
        )}
      </CardContent>
    </Card>
  </div>
</CustomerLayout>
