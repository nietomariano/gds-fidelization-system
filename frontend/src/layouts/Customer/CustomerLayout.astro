---
import "../../styles/global.css";
import { APP_NAME } from "@/config/app";
import { SidebarProvider, SidebarInset, SidebarTrigger } from "@/components/ui/sidebar";
import CustomerSidebar from "../../components/Customer/CustomerSidebar.tsx";
import { Separator } from "@/components/ui/separator";
import { Toaster } from "@/components/ui/sonner";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} - Portal Cliente - ${APP_NAME}` : `Portal Cliente - ${APP_NAME}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <SidebarProvider client:load>
      <CustomerSidebar client:load />
      <SidebarInset client:load>
        <header class="flex h-16 shrink-0 items-center gap-2 border-b border-border px-4">
          <SidebarTrigger className="-ml-1" client:load />
          <Separator orientation="vertical" className="mr-2 h-4" client:load />
          <div class="flex items-center gap-2">
            <h1 class="text-lg font-semibold">Portal Cliente</h1>
          </div>
        </header>
        <div class="flex flex-1 flex-col gap-4 p-4 md:p-6">
          <slot />
        </div>
      </SidebarInset>
    </SidebarProvider>
    <Toaster client:load />
  </body>
</html>
